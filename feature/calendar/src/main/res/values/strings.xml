    <!-- Says what is lost. There is no calendar bin, unlike mail's Trash. -->
    <string name="calendar_delete_body">This cannot be undone: a calendar has no bin to recover from.</string>
    <string name="calendar_delete_body_recurring">This deletes every occurrence of the event, not just this one. It cannot be undone: a calendar has no bin to recover from.</string>

