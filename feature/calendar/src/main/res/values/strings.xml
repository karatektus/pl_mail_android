    <!--
      Calm rather than cheerful. An empty month is an ordinary state, and a
      screen that congratulates somebody on it is a screen they stop reading.
    -->
    <string name="calendar_empty">Nothing coming up</string>
    <string name="calendar_empty_body">The next 30 days are clear.</string>
    <string name="calendar_loading">Loading your calendar…</string>

    <string name="calendar_offline">You are offline. This is the calendar already on your phone.</string>
    <string name="calendar_unreachable">plMail could not reach %1$s. This is the calendar already on your phone.</string>
    <string name="calendar_unreachable_unnamed">plMail could not reach your server. This is the calendar already on your phone.</string>
    <!-- The server's own words. Several refusals here carry nothing else. -->
    <string name="calendar_refresh_refused">The calendar could not be refreshed: %1$s</string>

    <!--
      The client cannot promise a far month is complete and must not pretend it
      can: the server publishes how far it materialises as an opaque phrase, so
      its words are quoted rather than parsed.
    -->
    <string name="calendar_horizon">Your server writes out repeating events for a bounded time around today (%1$s), so days beyond that may be incomplete.</string>
    <string name="calendar_horizon_generic">Your server writes out repeating events for a bounded time around today, so days far ahead may be incomplete.</string>

    <!--
      One sentence per row for TalkBack, in place of four fragments the listener
      would have to reassemble.
    -->
    <string name="calendar_row_a11y">%1$s, %2$s, on %3$s</string>
    <string name="calendar_row_a11y_located">%1$s, %2$s, at %3$s, on %4$s</string>

