            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="de.plmail.LogoLauncherBurgundy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_burgundy"
            android:roundIcon="@mipmap/ic_launcher_burgundy"
            android:targetActivity=".MainActivity">
