<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      plMail talks to a server the user owns: a NAS, a home box, a Tailscale
      node. INTERNET is the whole product. ACCESS_NETWORK_STATE lets sync back
      off when there is nothing to reach rather than retrying into a flat
      battery.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PlMailApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlMail">

        <!--
          No android:label here: it would repeat the application's, and a
          duplicate is one more place to forget when the name changes.
        -->
        <!--
          singleTask so a tapped pairing link reaches the activity that is
          already running rather than stacking a second copy of it. Onboarding
          is usually already open when the link is tapped — the user went
          looking for the code because the app asked for one — and a second
          instance would redeem against a ViewModel the visible screen is not
          observing.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PlMail">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The pairing deep link. When the QR is on the same device as the
              app, tapping it skips the camera entirely, which is the whole
              flow — and it is also the fallback when camera permission is
              refused. No autoVerify: plmail:// is our own scheme, not an
              https:// one that needs Digital Asset Links.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="plmail" android:host="pair" />
            </intent-filter>
        </activity>
    </application>

</manifest>
