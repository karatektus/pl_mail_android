<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      plMail talks to a server the user owns: a NAS, a home box, a Tailscale
      node. INTERNET is the whole product. ACCESS_NETWORK_STATE lets sync back
      off when there is nothing to reach rather than retrying into a flat
      battery.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Notifications are asked for at the moment push is switched on, not at
      launch: a permission prompt before the user has connected a server is one
      they have no way to evaluate.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility for UnifiedPush.

      Since Android 11 an app cannot see another unless it declares a query for
      it. Distributor discovery works by resolving this action, so without this
      block the connector finds no distributors at all on a device where one is
      installed, and push simply never starts, with nothing logged and nothing
      to see. It is the single easiest way for this to look broken.
    -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
    </queries>

    <application
        android:name=".PlMailApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlMail">

        <!--
          No android:label here: it would repeat the application's, and a
          duplicate is one more place to forget when the name changes.
        -->
        <!--
          singleTask so a tapped pairing link reaches the activity that is
          already running rather than stacking a second copy of it. Onboarding
          is usually already open when the link is tapped — the user went
          looking for the code because the app asked for one — and a second
          instance would redeem against a ViewModel the visible screen is not
          observing.
        -->
        <!--
          adjustResize, and it is a bug fix rather than tidiness.

          Left unset the mode is SOFT_INPUT_ADJUST_UNSPECIFIED, which asks the
          window manager to guess. It guesses by looking for a scrolling view in
          the hierarchy, finds none — a Compose activity is one ComposeView with
          no ScrollView anywhere the platform can recognise — and settles on
          PAN. Panning translates the whole window upward to keep the cursor
          visible, so opening the keyboard in the composer's message body slid
          the top app bar up underneath the status bar, title and back arrow cut
          in half. Nothing in the Compose code could have corrected that: the
          window itself had moved.

          With adjustResize the window stays where it is and the IME arrives as
          an inset instead, which is what the app already knows how to spend —
          see ComposeScreen's imePadding. The two have to be set together:
          adjustResize alone under edge-to-edge would leave the body behind the
          keys, and imePadding alone cannot un-pan a window.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PlMail"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The pairing deep link. When the QR is on the same device as the
              app, tapping it skips the camera entirely, which is the whole
              flow — and it is also the fallback when camera permission is
              refused. No autoVerify: plmail:// is our own scheme, not an
              https:// one that needs Digital Asset Links.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="plmail" android:host="pair" />
            </intent-filter>
        </activity>
        <!--
          The calendar as its own app, off unless the user asks for it.

          THE TASK MODEL, which is the whole reason this is an activity of its
          own rather than an extra door into MainActivity.

          What was wanted: a second launcher icon that forms a SEPARATE task, so
          the calendar gets its own card in Recents, its own back stack, and can
          sit beside the mail in split screen. Back out of the calendar app
          leaves it, rather than revealing an inbox the user never opened.

          What an activity-alias can and cannot do. Its attribute set is a
          subset of an activity's: name, targetActivity, label, icon, roundIcon,
          permission, exported, enabled. Everything outside that subset is
          inherited from the target and CANNOT be overridden on the alias, and
          taskAffinity and launchMode are both outside it. An alias pointed at
          MainActivity therefore inherits MainActivity's affinity and its
          singleTask, which means the launcher icon would reach the mail task
          that is already running and hand it an onNewIntent. One card in
          Recents, one back stack, no split screen: exactly what was not wanted,
          and it would have looked like it worked on the first tap.

          So the affinity is declared where it is legal, on a second activity,
          and the alias inherits it from there. That inheritance is the
          mechanism rather than a workaround: the alias exists to carry the
          icon, the label and the enabled flag the settings toggle writes, and
          the activity behind it exists to own the task.

          taskAffinity=":calendar" and not a spelled-out name. A leading colon
          is expanded at install time against the applicationId, so this is
          "de.plmail:calendar" in the foss build and "de.plmail.google:calendar"
          in the other, with ".debug" folded in for a debug build. Two flavours
          installed side by side, which this project does while it compares the
          push paths, therefore cannot end up sharing a calendar task.

          launchMode="singleTask" for the same reason MainActivity has it, and
          with the same effect confined to this affinity: tapping the calendar
          icon while the calendar is already open brings that task forward
          rather than stacking a second calendar. The two activities never
          contend for one instance, because there is no one instance to contend
          for. That is the part an alias over MainActivity could not have given.

          exported="false" on the activity is correct and is not the mistake it
          would look like. The launcher resolves the ALIAS, and it is the
          alias's exported flag that the permission check reads; the target is
          then instantiated inside our own process. Nothing outside the app can
          name this activity directly.

          enabled="false" on the alias is the default state, and it is the fact
          the settings toggle flips through PackageManager. It is deliberately
          not mirrored into DataStore: the system owns this, and a second copy
          would be a second copy that can be wrong.
        -->
        <!--
          adjustResize here too, for the reason MainActivity's note gives. The
          calendar app has an event editor with text fields in it, so it is the
          same window that would otherwise be panned — and two activities onto
          the same install disagreeing about how the keyboard arrives is the
          kind of difference nobody notices until one of them is reported.
        -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=":calendar"
            android:theme="@style/Theme.PlMail"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Its own label and its own icon, both in resources so German gets the
          word it actually uses. Declared here in src/main rather than per
          flavour, so foss and google both have it without either being able to
          drift from the other.
        -->
        <activity-alias
            android:name=".CalendarLauncher"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calendar"
            android:label="@string/calendar_app_name"
            android:roundIcon="@mipmap/ic_launcher_calendar_round"
            android:targetActivity=".CalendarActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          UnifiedPush delivery, and it must be exported.
          
          A distributor is a *different app*, so it delivers by broadcast across
          a package boundary, which a non-exported receiver cannot receive at
          all. Exported="false" here is not a safer choice, it is a silent one:
          the distributor logs a successful send and the app never hears it.
          
          What actually protects this is the connector's token. Every event
          carries the one issued at registration, and the library drops
          anything whose token it did not hand out, so a payload from another
          app is discarded before it reaches any of the code below.

          Lint wants a permission on an exported receiver and is right to in
          general. There is none to require here: a distributor is any app the
          user chose, known only at runtime, so a custom permission would have
          to be held by an app that has never heard of us. UnifiedPush's answer
          is the token, and this is the one place it applies.
        -->
        <receiver
            android:name=".push.PlMailPushReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
