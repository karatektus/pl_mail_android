<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer: the same mark with its colour taken out.

  A separate drawable rather than reusing the foreground, because the foreground
  is four brand colours and this one is tinted wholesale by the launcher. Passing
  the colour version would mean the strokes' own hues fighting a filter that is
  going to overwrite them anyway, and the result differs by launcher — which is
  the sort of thing that looks fine on the device it was checked on.

  Geometry, scale and translate are identical to ic_launcher_foreground so the
  themed and coloured icons sit at exactly the same size and position; see that
  file for why the numbers are what they are. Black is a placeholder the system
  replaces, not a colour choice.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.2"
        android:scaleY="1.2"
        android:translateX="18.6"
        android:translateY="25.2">

        <path
            android:fillColor="#00000000"
            android:pathData="M15,10 L15,38"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />

        <path
            android:fillColor="#00000000"
            android:pathData="M15,10 Q15,6 19,6 L25,6 Q31,6 31,12"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />

        <path
            android:fillColor="#00000000"
            android:pathData="M31,12 L31,26"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />

        <path
            android:fillColor="#00000000"
            android:pathData="M31,26 Q31,30 25,30 L19,30 Q15,30 15,26"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />

        <path
            android:fillColor="#00000000"
            android:pathData="M37,7 L37,26"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5" />

        <path
