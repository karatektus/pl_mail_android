<?xml version="1.0" encoding="utf-8"?>
<!--
  An adaptive-icon foreground: a 108dp canvas whose outer ring is cropped by
  whatever mask the launcher applies, leaving a 72dp safe zone in the middle.
  The envelope is kept inside x/y 30..78 so no launcher shape clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:pathData="M32,42 L76,42 L76,66 L32,66 Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

    <path
        android:fillColor="#00000000"
        android:pathData="M32,42 L54,58 L76,42"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="4" />

</vector>
