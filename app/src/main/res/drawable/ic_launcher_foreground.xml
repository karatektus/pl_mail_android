                android:pathData="M29,22 Q29,26 23,26 L17,26 Q13,26 13,22"
                android:strokeColor="#c026d3"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />

            <path
