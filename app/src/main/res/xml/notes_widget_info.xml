<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen notes widget, after Google Keep's: resizable both ways, the
  note cards scroll. Re-rendered by the app whenever its notes change, and
  every 30 minutes otherwise.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/notes_widget_description" />
