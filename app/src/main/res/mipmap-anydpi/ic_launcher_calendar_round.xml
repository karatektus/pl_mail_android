<?xml version="1.0" encoding="utf-8"?>
<!--
  The round variant, identical to ic_launcher_calendar for the same reason
  ic_launcher_round is identical to ic_launcher: an adaptive icon is already
  masked to whatever shape the launcher wants, so there is nothing left for a
  round variant to do differently. It exists because android:roundIcon is a
  separate attribute and a launcher that asks for it should not fall back.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_calendar_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_calendar_monochrome" />
</adaptive-icon>
